{
	rootNode =
	{
		_class = "RootNode"
		children =
		[
			// Reuse the exact render mesh, material and 156-bone skeleton compiled by
			// the active custom siege model; only the deathsim sequence contract differs.
			{
				_class = "MaterialGroupList"
				children =
				[
					{
						_class = "DefaultMaterialGroup"
						remaps =
						[
							{
								from = "models/creeps/lane_creeps/creep_bad_melee/creep_bad_flagbearer.vmat"
