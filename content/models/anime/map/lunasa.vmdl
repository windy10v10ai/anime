{
	rootNode =
	{
		_class = "RootNode"
		children =
		[
			// Preserve the seven recovered DMX material slots while moving every
			// model-owned material into the map-local material namespace.
			{
				_class = "MaterialGroupList"
				children =
				[
					{
						_class = "DefaultMaterialGroup"
						remaps =
						[
							{
								from = "models/lunasa/lunasa.fbm/body.vmat"
								to = "materials/anime/map/lunasa_body.vmat"
							},
							{
								from = "models/lunasa/lunasa.fbm/bow.vmat"
								to = "materials/anime/map/lunasa_bow.vmat"
							},
							{
								from = "models/lunasa/lunasa.fbm/cloth.vmat"
								to = "materials/anime/map/lunasa_cloth.vmat"
							},
							{
								from = "models/lunasa/lunasa.fbm/face.vmat"
								to = "materials/anime/map/lunasa_face.vmat"
							},
							{
								from = "models/lunasa/lunasa.fbm/hair.vmat"
								to = "materials/anime/map/lunasa_hair.vmat"
							},
							{
								from = "models/lunasa/lunasa.fbm/underwear.vmat"
								to = "materials/anime/map/lunasa_underwear.vmat"
							},
							{
								from = "models/lunasa/lunasa.fbm/violent.vmat"
								to = "materials/anime/map/lunasa_violent.vmat"
							},
						]
						use_global_default = false
						global_default_material = ""
					},
				]
			},
			{
				_class = "BoneMarkupList"
				children = [  ]
				bone_cull_type = "None"
			},
			// The recovered DMX is the single authoritative source for mesh and skeleton.
			{
				_class = "RenderMeshList"
				children =
				[
					{
						_class = "RenderMeshFile"
						name = "lunasa"
						filename = "models/anime/map/lunasa/lunasa.dmx"
					},
				]
			},
			// Attachments retain the exact source parent bones, transforms and weights.
			{
				_class = "AttachmentList"
				children =
				[
					{
						_class = "Attachment"
						name = "attach_hitloc"
						ignore_rotation = false
						parent_bone = "7_joint_Torso2"
						relative_origin = [ 0.0, 0.0, 0.0 ]
						relative_angles = [ -0.0, 0.0, 0.0 ]
						weight = 1.0
					},
					{
						_class = "Attachment"
						name = "attach_weapon"
